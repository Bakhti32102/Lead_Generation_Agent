# ============================================================
# AI LEAD GENERATION AGENT — Environment Configuration
# Copy this to .env and fill in your values.
# ============================================================
#
# REQUIRED: You must configure at least the LLM and one Search API
#           to run the discovery pipeline.
#
# OPTIONAL: Google Maps, Email, WhatsApp, Google Sheets are all
#           optional — the system gracefully skips unconfigured
#           integrations and logs a warning.
#
# SECRETS:  Never commit .env to Git. It is already in .gitignore.
# ============================================================


# ============================================================
# REQUIRED — LLM (at least one provider)
# ============================================================

# Provider: openai | anthropic | gemini | groq
LLM_PROVIDER=openai

# Model name (provider-specific)
# openai:    gpt-4o, gpt-4o-mini, gpt-3.5-turbo
# anthropic: claude-3-sonnet, claude-3-haiku
# gemini:    gemini-pro, gemini-1.5-flash
# groq:      llama3-70b-8192, mixtral-8x7b-32768
LLM_MODEL=gpt-4o-mini

# Your API key for the selected provider
LLM_API_KEY=


# ============================================================
# REQUIRED — Search API (at least one provider)
# ============================================================

# Provider: tavily | serpapi | google_cse | bing
SEARCH_PROVIDER=tavily

# API key for the selected search provider
# Tavily:    https://tavily.com  (free tier available)
# SerpAPI:   https://serpapi.com  (free tier available)
# Google CSE: requires Google API key + Custom Search Engine ID
# Bing:      https://www.microsoft.com/en-us/bing/apis/bing-web-search-api
SEARCH_API_KEY=


# ============================================================
# OPTIONAL — Google Maps / Places API
# ============================================================
# Used for: Discovering local businesses with contact details
# Get key:  https://console.cloud.google.com → APIs → Places API
GOOGLE_MAPS_API_KEY=


# ============================================================
# OPTIONAL — Google Sheets (CRM)
# ============================================================
# Used for: Saving leads, tracking outreach, follow-up management
#
# 1. Create a Google Cloud project
# 2. Enable Google Sheets API
# 3. Create a Service Account → download JSON key file
# 4. Place the JSON file in this project root (E:\Lead_Generation_Agent\)
# 5. Share your Google Sheet with the service account email
#
# GOOGLE_SERVICE_ACCOUNT_JSON: path to the service account JSON file
# GOOGLE_SHEET_ID: the spreadsheet ID from the URL
#   (e.g., https://docs.google.com/spreadsheets/d/XXXXX/edit → XXXXX)
# GOOGLE_WORKSHEET_NAME: the tab name (default: Leads)

GOOGLE_SERVICE_ACCOUNT_JSON=service_account.json
GOOGLE_SHEET_ID=
GOOGLE_WORKSHEET_NAME=Leads


# ============================================================
# OPTIONAL — Email Outreach
# ============================================================
# Used for: Sending personalized outreach emails
#
# Providers:
#   gmail   — Uses Gmail API with service account (reuse Google Sheets credentials)
#   resend  — https://resend.com (free tier: 100 emails/day)
#   sendgrid — https://sendgrid.com (free tier: 100 emails/day)
#   smtp    — Any SMTP server (set EMAIL_SMTP_HOST, EMAIL_SMTP_PORT, etc.)

EMAIL_PROVIDER=resend
EMAIL_API_KEY=
EMAIL_FROM=


# ============================================================
# OPTIONAL — WhatsApp Business API
# ============================================================
# Uses official Meta Cloud API: https://developers.facebook.com/docs/whatsapp/cloud-api
# DO NOT use unofficial session hijacking or automation.
#
# 1. Create Meta Business account
# 2. Set up WhatsApp Business API
# 3. Get access token and phone number ID

WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=


# ============================================================
# YOUR BUSINESS INFORMATION
# ============================================================
# Used for: Personalizing outreach messages

MY_NAME=
MY_BUSINESS_DESCRIPTION=AI Agent Developer specializing in business automation
MY_EMAIL=
MY_WHATSAPP_NUMBER=
MY_WEBSITE_URL=
MY_FIVERR_URL=
MY_LINKEDIN_URL=


# ============================================================
# CAMPAIGN TARGET
# ============================================================
# These are the defaults. You can override them per-run via CLI:
#   python -m app.main run --country Pakistan --city Lahore --category "Dental Clinics" --count 10

TARGET_COUNTRY=
TARGET_CITY=
TARGET_BUSINESS_CATEGORY=
DAILY_LEAD_TARGET=15


# ============================================================
# SCORING & LIMITS
# ============================================================

# Minimum score (0-100) for a lead to be contacted
LEAD_SCORE_THRESHOLD=60

# Maximum outreach messages per day (default: 15)
MAX_DAILY_OUTREACH=15

# Follow-up limits (system stops after this many)
MAX_FOLLOWUPS_INITIAL=1
MAX_FOLLOWUPS_3DAY=1
MAX_FOLLOWUPS_7DAY=1


# ============================================================
# MODES
# ============================================================

# DRY_RUN: When true, searches and generates messages but sends nothing
DRY_RUN=true

# REVIEW_MODE: When true, messages are saved as drafts for your approval
#              When false, messages are sent automatically (subject to DRY_RUN)
REVIEW_MODE=true


# ============================================================
# SCHEDULER
# ============================================================

SCHEDULER_ENABLED=false
SCHEDULER_CRON_HOUR=9
SCHEDULER_CRON_MINUTE=0


# ============================================================
# NOTIFICATIONS (for human escalation)
# ============================================================

NOTIFICATION_METHOD=email
NOTIFICATION_EMAIL=


# ============================================================
# LOGGING
# ============================================================

LOG_LEVEL=INFO
